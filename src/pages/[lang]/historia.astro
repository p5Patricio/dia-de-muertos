---
import { changeLanguage } from 'i18next';
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import { defaultLocale, isLocale, type Locale } from '@lib/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const locale: Locale = isLocale(lang) ? lang : defaultLocale;
changeLanguage(locale);

const entries = await getCollection('historia', (entry) => entry.data.lang === locale);
const entry = entries[0];
if (!entry) throw new Error(`No historia content found for locale ${locale}`);
const { Content } = await entry.render();
---

<Layout locale={locale} title={entry.data.title} description={entry.data.description}>
  <article class="container mx-auto px-4 py-16 md:py-24">
    <header class="mx-auto max-w-3xl text-center">
      <h1 class="font-display text-4xl text-foreground md:text-5xl">{entry.data.title}</h1>
      <p class="mt-4 text-lg text-muted-foreground">{entry.data.description}</p>
    </header>
    <div class="content-body mx-auto mt-12 max-w-3xl"><Content /></div>
  </article>
</Layout>
