---
import { changeLanguage } from 'i18next';
import Layout from '@layouts/Layout.astro';
import Hero from '@components/sections/Hero.tsx';
import SectionPreview from '@components/sections/SectionPreview.astro';
import { defaultLocale, isLocale, loadTranslations, type Locale } from '@lib/i18n';
import { localizePath, t } from '@lib/i18n-shared';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const locale: Locale = isLocale(lang) ? lang : defaultLocale;

changeLanguage(locale);
const translations = await loadTranslations(locale);

const ctaHref = localizePath('/historia', locale);
const title = t(translations, 'nav.home', 'Home');
const description = t(translations, 'home.subtitle', 'A celebration of life, memory, and color.');
---

<Layout locale={locale} title={title} description={description}>
  <Hero locale={locale} translations={translations} ctaHref={ctaHref} />
  <SectionPreview locale={locale} translations={translations} />
</Layout>
