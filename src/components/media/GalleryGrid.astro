---
import Lightbox from './Lightbox.tsx';
import type { GalleryItem } from '@/types/media';
import type { TranslationDict } from '@lib/i18n-shared';

interface Props {
  items: GalleryItem[];
  locale: string;
  translations: TranslationDict;
}

const { items, translations } = Astro.props;
---

<section id="gallery" class="container mx-auto px-4 py-16 md:py-24">
  <div id="gallery-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" role="list">
    {
      items.map((item, index) => (
        <button
          type="button"
          data-gallery-index={index}
          class="group relative overflow-hidden rounded-xl border border-border/60 bg-card text-left transition-all hover:border-cempasuchil-500/50 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          <img
            src={item.src}
            alt={item.alt}
            loading="lazy"
            decoding="async"
            class="aspect-[3/2] w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-4 pt-12 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
            <p class="font-display text-lg text-white">{item.title}</p>
            <p class="text-xs uppercase tracking-wide text-white/80">{item.category}</p>
          </div>
        </button>
      ))
    }
  </div>
  <Lightbox client:visible items={items} translations={translations} />
</section>
