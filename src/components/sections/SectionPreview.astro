---
import { BookOpen, Images, Sparkles, Music, Video, ChefHat } from 'lucide-react';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@components/ui/card';
import { localizePath, t, type Locale, type TranslationDict } from '@lib/i18n-shared';

interface Props {
  locale: Locale;
  translations: TranslationDict;
}

const { locale, translations } = Astro.props;

const sections = [
  {
    key: 'history',
    href: '/historia',
    icon: BookOpen,
  },
  {
    key: 'elements',
    href: '/elementos',
    icon: Sparkles,
  },
  {
    key: 'gallery',
    href: '/galeria',
    icon: Images,
  },
  {
    key: 'music',
    href: '/musica',
    icon: Music,
  },
  {
    key: 'videos',
    href: '/videos',
    icon: Video,
  },
  {
    key: 'recipes',
    href: '/recetas',
    icon: ChefHat,
  },
];
---

<section id="intro" class="relative py-20 md:py-28">
  <div class="container mx-auto px-4 md:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-3xl text-foreground md:text-4xl">
        {t(translations, 'home.intro.title', 'A tradition that unites worlds')}
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">
        {t(translations, 'home.intro.text', 'Día de Muertos is a Mexican celebration where families remember their loved ones with offerings, flowers, music, and color.')}
      </p>
    </div>

    <div class="mt-16">
      <h3 class="mb-8 text-center font-display text-2xl text-foreground">
        {t(translations, 'home.sections.title', 'Explore the celebration')}
      </h3>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          sections.map((section) => {
            const Icon = section.icon;
            const title = t(translations, `home.sections.${section.key}.title`, section.key);
            const description = t(
              translations,
              `home.sections.${section.key}.description`,
              '',
            );
            return (
              <a
                href={localizePath(section.href, locale)}
                class="group block rounded-xl transition-transform focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
              >
                <Card className="h-full border-border/60 bg-card/80 transition-colors group-hover:border-cempasuchil-500/50 group-hover:bg-card">
                  <CardHeader>
                    <div class="mb-3 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-cempasuchil-500/10 text-cempasuchil-500">
                      <Icon className="h-6 w-6" aria-hidden="true" />
                    </div>
                    <CardTitle>{title}</CardTitle>
                  </CardHeader>
                  <CardContent>
                    <CardDescription>{description}</CardDescription>
                  </CardContent>
                </Card>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
